# Copie para .env.production e configure os valores antes de iniciar o Compose.
# Gere SEGREDOS com python -c "import secrets; print(secrets.token_hex(32))".
ENVIRONMENT=production
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://criticard:${POSTGRES_PASSWORD}@postgres:5432/criticard
SESSION_COOKIE_SECURE=1
FLASK_DEBUG=0

# HTTPS é terminado pelo proxy/plataforma, com WebSocket e Host preservados.
TRUSTED_HOSTS=criticard.example.com
HEALTHCHECK_HOST=criticard.example.com
PROXY_HOPS=0
ACCOUNT_BASE_URL=https://criticard.example.com

# Obrigatório em produção; o web app grava a fila privada e o worker a envia.
ACCOUNT_MAIL_BACKEND=smtp
ACCOUNT_MAIL_FROM=noreply@criticard.example.com
ACCOUNT_SMTP_HOST=smtp.example.com
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_TLS=starttls
ACCOUNT_OUTBOX_PATH=/app/instance/outbox

# Local usa volumes persistentes; S3 usa apenas capas e avatares públicos.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=criticard

# Opcional: conta de administração criada pelo comando db-upgrade.
ADM_USERNAME=
ADM_SENHA=
ADM_EMAIL=admin@criticard.example.com

# Complete o canal público de privacidade e os procedimentos em docs/privacy-operations.md.
PRIVACY_CONTROLLER_NAME=Luis Duarte
PRIVACY_CONTACT_EMAIL=
