# Opcional no desenvolvimento: uma chave local persistente é criada automaticamente.
SECRET_KEY=
DATABASE=criticard.db
DATABASE_URL=
ENVIRONMENT=development
SESSION_COOKIE_SECURE=0
TRUSTED_HOSTS=
PROXY_HOPS=0
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Preencha os dois campos para criar o primeiro administrador.
ADM_USERNAME=
ADM_SENHA=
ADM_EMAIL=admin@example.com

# Desenvolvimento local: disabled; file grava links em instance/outbox sem enviar emails.
ACCOUNT_MAIL_BACKEND=disabled
ACCOUNT_BASE_URL=http://127.0.0.1:5000
ACCOUNT_OUTBOX_PATH=instance/outbox
ACCOUNT_MAIL_FROM=no-reply@criticard.test
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_TLS=starttls

# local mantém imagens atuais. Para S3, configure credenciais explícitas e URL pública HTTPS.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=criticard

# Responsável confirmado; defina o canal externo antes da disponibilização pública.
PRIVACY_CONTROLLER_NAME=Luis Duarte
PRIVACY_CONTACT_EMAIL=
